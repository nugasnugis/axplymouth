joke_count = 70;
current_index = Math.Int(Math.Random() * joke_count);

# 2. Geometry Setup
screen_width = Window.GetWidth();
screen_height = Window.GetHeight();

# Initialize Graphics Elements
joke_sprite = Sprite();
subtitle_sprite = Sprite();
border_top = Sprite();
border_bottom = Sprite();
border_left = Sprite();
border_right = Sprite();

# Object tracking for the glow engine coordinates
box_dimensions.x = 0;
box_dimensions.y = 0;
box_dimensions.w = 0;
box_dimensions.h = 0;

function display_joke(index) {
  joke_text = jokes[index];
  
  # Chef Orange Theme Font Colors (#FF8C00 -> R=1.0, G=0.55, B=0.0)
  joke_image = Image.Text(joke_text, 1.0, 0.55, 0.0, 1.0, "Courier 16");
  
  text_x = (screen_width / 2) - (joke_image.GetWidth() / 2);
  text_y = (screen_height / 2) - (joke_image.GetHeight() / 2);
  
  joke_sprite.SetImage(joke_image);
  joke_sprite.SetPosition(text_x, text_y, 10);
  
  # Border Wrap Calculations
  padding = 35;
  box_dimensions.w = joke_image.GetWidth() + (padding * 2);
  box_dimensions.h = joke_image.GetHeight() + (padding * 2);
  box_dimensions.x = text_x - padding;
  box_dimensions.y = text_y - padding;
  
  # Subtitle Recipe Ticker Banner below the Menu Box
  sub_image = Image.Text("--- Chef systemd's Kitchen: Compiling Flavor ---", 0.7, 0.4, 0.0, 0.8, "Courier Italic 11");
  sub_x = (screen_width / 2) - (sub_image.GetWidth() / 2);
  sub_y = box_dimensions.y + box_dimensions.h + 25;
  subtitle_sprite.SetImage(sub_image);
  subtitle_sprite.SetPosition(sub_x, sub_y, 10);
}

# Run initial execution frame
display_joke(current_index);

# 3. Dynamic Glow & Loop Animation Engine
last_change_time = 0;
thickness = 3;

function refresh_callback(time) {
  # STOVE BURNER GLOW: Pulsate border transparency between 0.4 and 1.0 continuously
  glow_factor = 0.7 + (Math.Sin(time * 4) * 0.3); 
  
  # Draw vector color strips without demanding system file attachments
  orange_glow_pixel = Image.ConstantLib(1.0, 0.55, 0.0, glow_factor);
  
  border_top.SetImage(orange_glow_pixel.Scale(box_dimensions.w, thickness));
  border_top.SetPosition(box_dimensions.x, box_dimensions.y, 5);
  
  border_bottom.SetImage(orange_glow_pixel.Scale(box_dimensions.w, thickness));
  border_bottom.SetPosition(box_dimensions.x, box_dimensions.y + box_dimensions.h - thickness, 5);
  
  border_left.SetImage(orange_glow_pixel.Scale(thickness, box_dimensions.h));
  border_left.SetPosition(box_dimensions.x, box_dimensions.y, 5);
  
  border_right.SetImage(orange_glow_pixel.Scale(thickness, box_dimensions.h));
  border_right.SetPosition(box_dimensions.x + box_dimensions.w - thickness, box_dimensions.y, 5);

  # Rotate joke text non-repetitively every 3.2 seconds
  if (time - last_change_time > 3.2) {
    last_change_time = time;
    current_index = (current_index + 1) % joke_count;
    display_joke(current_index);
  }
}

Plymouth.SetRefreshFunction(refresh_callbac
